# ---- Core ----
NODE_ENV=development
PORT=5000
# MongoDB connection string. Use a replica set / Atlas in production so
# financial writes run inside transactions.
MONGO_URI=mongodb://127.0.0.1:27017/bachelormate
# Long random string (>= 32 chars in production). JWT_SECRET is accepted as a legacy fallback.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# ---- Frontend / CORS ----
# Used in email links (reset password, verify email, invitations).
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173
# Cross-site deployments (frontend and API on different domains) need
# COOKIE_SAMESITE=none and COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set true when running behind a proxy/load balancer (Render, Railway, Nginx).
TRUST_PROXY=false

# ---- Email (optional; without SMTP, emails are printed to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BachelorMate <no-reply@example.com>"

# ---- Google sign-in via Firebase (optional) ----
# Your Firebase project id; ID tokens are verified against Google's keys.
FIREBASE_PROJECT_ID=

# ---- Deployment helpers ----
# Serve the built client (client/dist) from this server: one URL for app + API.
SERVE_CLIENT=false
# Load the demo home on startup if the demo accounts don't exist yet.
SEED_DEMO=false
# Password for demo accounts (seed script + SEED_DEMO). Default: Demo@1234
DEMO_PASSWORD=

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
