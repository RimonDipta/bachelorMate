# API base URL. Leave empty in development: Vite proxies /api, /uploads and
# /socket.io to http://localhost:5000. In production set the API origin,
# e.g. https://api.yourdomain.com
VITE_API_URL=

# Only when the REST API is reached through a rewrite/proxy (Vercel → Render):
# the API's real origin, so WebSockets connect to it directly.
VITE_SOCKET_URL=

# Optional Google sign-in (Firebase). Leave empty to hide the Google button.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
